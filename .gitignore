# Mirage / Apate — local data stays local.
# This does not remove already tracked files or secrets from Git history.
# Review staged changes before committing; ignore rules are not a secret scanner.

# Credentials and operator configuration (templates remain versionable).
.env
.env.*
.env.azure
!.env.example
!.env.sample
!.env.template
.envrc
/secrets/
/credentials/
/keys/
/certs/
/certificates/
/docker_secrets/
/.aws/
/.azure/
/.gcp/
/.cloud/
/.kube/
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.kubeconfig
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
ssh_host_*_key
ssh_host_*_key.pub
.netrc
.pypirc
.npmrc
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
.terraform/
crash.log

# Local deployment, credentials, app bundles and operator exports.
/.local-deploy/
/outputs/
/report_workspace/
/docker-compose.override.yml
/docker-compose.override.yaml
/docker-compose.local.yml
/docker-compose.production.yml
/docker-compose.secrets.yml
/compose.override.yml
/compose.override.yaml
/models.override.yml
/Dockerfile.local
/.docker/
/volume_data/
/container_logs/
/config/*.local.*
/config/*.private.*

# Runtime research data: never opt in whole directories of participant data.
/data/
/logs/
/log/
/exports/
/backups/
/dumps/
/snapshots/
/session_recordings/
/network_captures/
/malware_samples/
/file_uploads/
/honeytokens/active/
/honeytokens/deployed/
/honeytokens/accessed/
*.pcap
*.pcapng
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.db
*.db-*
*.rdb
*.aof
*.aof.*
*.log
*.log.*
*.pid
*.sock
*.core

# Generated evidence is private/unreviewed by default, including JSON and scans.
# Existing tracked evidence stays tracked. For a reviewed release, explicitly
# git add -f only individual sanitized artifacts; do not force-add the directory.
# Keep acceptance summaries and artifact hashes in docs/.
/evidence/

# Python environments, build products and test caches.
__pycache__/
*.py[cod]
*.so
.venv/
venv/
env/
ENV/
.python-version.local
build/
dist/
*.egg-info/
.eggs/
*.egg
*.whl
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
coverage.json
/test_results/
/test_reports/
/test_outputs/
/profiling/

# Rust: application lockfiles MUST remain versionable.
target/
**/*.rs.bk

# Frontend dependencies and generated output; keep package lockfiles.
node_modules/
.npm/
.yarn/cache/
.yarn/unplugged/
.pnp.*
coverage/

# Model weights/caches and training output, not source modules named models.
/models/
/ai_models/
/training_data/
/ml_cache/
*.gguf
*.safetensors
*.onnx
*.pt
*.pth
*.h5
*.pkl

# Archives, disk images and packaged binaries.
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.rar
*.bz2
*.xz
*.dmg
*.iso
*.app/
*.exe

# Temporary files and documentation output; keep tooling configuration.
tmp/
temp/
.cache/
.tmp/
*.tmp
*.temp
*.bak
*.backup
*.swp
*.swo
*~
/docs/_build/
/docs/build/
/docs/files/
/site/

# Machine-specific editor/OS state.
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
*.code-workspace
.DS_Store
._*
.Trashes/
Thumbs.db
Desktop.ini
