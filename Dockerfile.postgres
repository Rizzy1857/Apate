FROM postgres:15-alpine@sha256:f7d23353e1b15400d22ebe31189f4d314b87a4c129cc400c8c2d8d4ca127bf81

# Non-root entrypoint skips gosu; named PGDATA volumes inherit image ownership.
# Root-owned bind mounts are intentionally not supported by this staging image.
RUN apk upgrade --no-cache && rm /usr/local/bin/gosu
USER postgres
